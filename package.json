{
  "name": "meow-meow-map",
  "version": "2.3.1",
  "description": "A cat discovery map for recording and sharing cat sightings",
  "main": "src/frontend/js/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "t2ek1ng0",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "eslint": "^10.12.0",
    "nodemon": "^3.1.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0",
    "axios": "^1.13.1",
    "form-data": "^4.0.5",
    "node-fetch": "^3.3.2"
  },
  "build": {
    "appId": "org.gaojiyingwen.meowmeowmap",
    "productName": "meow-meow-map",
    "copyright": "Copyright © Powered by t2zk1ng0",
    "directories": {
      "output": "build_output"
    },
    "win": {
      "target": "nsis",
      "icon": "src/frontend/assets/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "warningsAsErrors": false,
      "artifactName": "meow-meow-map-${version}-win-${arch}-Setup.exe",
      "installerHeaderIcon": "src/frontend/assets/favicon.ico"
    },
    "buildDependenciesFromSource": false,
    "forceCodeSigning": false,
    "extraResources": [
      {
        "from": "data/records.json",
        "to": "."
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhouJiataizjt/meow-meow.git"
  },
  "bugs": {
    "url": "https://github.com/ZhouJiataizjt/meow-meow/issues"
  },
  "homepage": "https://github.com/ZhouJiataizjt/meow-meow#readme"
}
